/* METATRON — thème Textual */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $panel;
    color: $text;
}

Footer {
    background: $panel;
}

/* Sélecteur de liste en rouge (comme l'en-tête METATRON) */
ListView ListItem.--highlight {
    background: $error 40%;
    color: $text;
}

#menu ListItem {
    padding: 0 1;
}

#menu ListItem > Label {
    padding: 1;
}

#ph-title {
    text-align: center;
    padding: 1;
    margin: 1 2;
    border: heavy $error;
    background: $panel;
}

#ph-msg {
    text-align: center;
    padding: 2;
    margin: 1 2;
    color: $text-muted;
}

/* ── Paramètres ── */
#settings-info {
    padding: 1 2;
    margin: 1 2;
    border: heavy $error;
    background: $panel;
}

#settings-menu {
    margin: 1 2;
    height: auto;
    max-height: 22;
    border: round $primary;
    background: $panel;
}

#settings-menu ListItem {
    padding: 0 1;
}

#settings-menu ListItem > Label {
    padding: 1;
}

/* ── Sélection de modèle ── */
#model-title {
    padding: 1 2;
    margin: 1 2;
    border: heavy $error;
    background: $panel;
}

#model-status {
    padding: 0 2;
    margin: 0 2;
}

#model-search {
    margin: 1 2 0 2;
    border: round $primary;
}

#model-list {
    margin: 1 2;
    border: round $primary;
    background: $panel;
}

/* ── Modals ── */
#key-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $panel;
}

#key-title, #test-title {
    text-align: center;
    padding: 1;
}

#key-input {
    margin: 1 0;
}

#test-status, #test-result {
    margin: 1 2;
    padding: 1;
}

#test-result {
    border: round $primary;
    background: $panel;
    min-height: 5;
}

/* ── Historique ── */
#history-title, #session-header, #run-title {
    padding: 1 2;
    margin: 1 2;
    border: heavy $error;
    background: $panel;
}

#history-status {
    padding: 0 2;
    margin: 0 2;
}

#history-table {
    margin: 1 2;
    border: round $primary;
    background: $panel;
}

#history-table DataTable, #vulns-table, #fixes-table, #exploits-table {
    background: $panel;
}

#analysis-text {
    padding: 1;
    margin: 1;
}

#run-log {
    padding: 0 1;
    margin: 1 2;
    border: round $primary;
    background: $panel;
    height: 1fr;
}

#run-log-static {
    padding: 1;
    margin: 1 2;
    border: round $primary;
    background: $panel;
}

/* ── Modals ── */
#export-dialog, #confirm-dialog, #lang-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $panel;
}

#export-title, #lang-title {
    text-align: center;
    padding: 1;
}

#confirm-msg {
    padding: 1;
    margin-bottom: 1;
}

/* ── Accueil (menu + bannière METATRON) ── */
#menu-root {
    width: 100%;
    height: auto;
}

#angel {
    height: auto;
    width: 100%;
    color: $error;
    text-align: center;
    padding: 1 0;
    background: $panel;
    border-bottom: heavy $error;
}

#banner {
    text-align: center;
    padding: 1 2;
    margin: 1 2;
    background: $panel;
    width: 100%;
}

#menu {
    margin: 1 2;
    height: auto;
    max-height: 16;
    border: round $primary;
    background: $panel;
    width: 100%;
}

/* ── Session : listes d'items (texte qui retourne à la ligne) ── */
#vulns-list, #fixes-list, #exploits-list {
    background: $panel;
    padding: 0 1;
}

#vulns-list ListItem, #fixes-list ListItem, #exploits-list ListItem {
    padding: 1 2;
    margin: 1 0;
    border-bottom: solid $primary 25%;
    height: auto;
}

#vulns-list ListItem:last-of-type, #exploits-list ListItem:last-of-type {
    border-bottom: none;
}

/* ── Chat IA (split view) ── */
#chat-left {
    width: 3fr;
    border: round $primary;
    background: $panel;
}

#chat-right {
    width: 2fr;
    border: round $primary;
    background: $panel;
}

#chat-title, #chat-context-title {
    padding: 1;
    text-align: center;
    border-bottom: solid $primary;
}

#chat-log {
    height: 1fr;
    background: $panel;
    padding: 0 1;
}

#chat-input {
    margin: 0 1 1 1;
}

#chat-context {
    padding: 1;
    margin: 1;
}

/* ── Test d'attaque ── */
#attack-title, #attack-warning, #attack-hint {
    padding: 0 2;
    margin: 1 2;
}

#attack-editor {
    height: 12;
    margin: 1 2;
    border: round $primary;
    background: $panel;
}

#attack-log {
    height: 1fr;
    margin: 1 2;
    border: round $primary;
    background: $panel;
    padding: 0 1;
}

/* ── Nouveau scan ── */
#scan-title {
    padding: 1 2;
    margin: 1 2;
    border: heavy $error;
    background: $panel;
}

#scan-target {
    margin: 0 2 1 2;
}

#scan-tools-label, #scan-hint {
    padding: 0 2;
    margin: 0 2;
}

#scan-tools {
    margin: 0 2 1 2;
    height: auto;
    max-height: 10;
    border: round $primary;
    background: $panel;
}

#scan-log {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $primary;
    background: $panel;
    padding: 0 1;
}

/* ── Édition / suppression ── */
#edit-header {
    padding: 1 2;
    margin: 1 2;
    border: heavy $error;
    background: $panel;
}

#edit-list {
    margin: 1 2;
    border: round $primary;
    background: $panel;
}

#textedit-dialog, #sev-dialog, #fix-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $panel;
}

#textedit-title, #sev-title, #fix-title {
    text-align: center;
    padding: 1;
}

#textedit-input {
    margin: 1 0;
}

#fix-text {
    padding: 1;
    margin: 1 0;
    border: round $primary;
    background: $panel;
    max-height: 10;
}
